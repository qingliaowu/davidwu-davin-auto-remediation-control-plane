# GitHub webhook configuration
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
GITHUB_ALLOWED_REPOSITORY=qingliaowu/superset
GITHUB_TARGET_BRANCH=main

# Devin API configuration
DEVIN_API_BASE_URL=https://api.devin.ai
DEVIN_API_KEY=your-devin-api-key
DEVIN_ORG_ID=your-devin-org-id
DEVIN_REPO=qingliaowu/superset
DEVIN_MODE=normal
DEVIN_MAX_ACU_LIMIT=100

# Dry-run mode: when true, the worker creates mock Devin sessions instead of real calls
# DEVIN_DRY_RUN=true

# Background worker configuration
POLL_INTERVAL_SECONDS=10
MAX_CONCURRENT_TASKS_PER_REPOSITORY=1

# Application configuration
DATABASE_URL=sqlite+aiosqlite:///./auto_remediation.db
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
